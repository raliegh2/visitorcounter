:root {
  color-scheme: light;
  --navy-950: #071a2b;
  --navy-900: #0b2238;
  --navy-800: #12324d;
  --navy-700: #1b4566;
  --brand-700: #0f5f5a;
  --brand-600: #0f766e;
  --brand-500: #14948a;
  --brand-100: #dff4f1;
  --brand-50: #f0faf8;
  --accent-600: #9a6a21;
  --accent-100: #faedce;
  --ink: #102438;
  --muted: #637487;
  --line: #d9e1e8;
  --line-strong: #c5d0da;
  --background: #f3f6f8;
  --surface-subtle: #f8fafb;
  --card: #ffffff;
  --green: #137044;
  --green-soft: #e8f7ef;
  --amber: #8a5a00;
  --amber-soft: #fff5d8;
  --red: #a33a43;
  --red-soft: #fff0f1;
  --blue: #2464a8;
  --blue-soft: #eaf3fb;
  --radius: 16px;
  --shadow-sm: 0 2px 8px rgba(7, 26, 43, .05);
  --shadow: 0 16px 42px rgba(7, 26, 43, .09);
  --shadow-lg: 0 28px 80px rgba(7, 26, 43, .16);
  --transition: 160ms cubic-bezier(.2, .75, .3, 1);
}

* { box-sizing: border-box; }
html { background: var(--background); color: var(--ink); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; text-rendering: optimizeLegibility; }
body { margin: 0; min-width: 320px; min-height: 100vh; background: var(--background); }
a { color: inherit; }
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
button:disabled, [aria-disabled="true"] { cursor: not-allowed; opacity: .62; transform: none !important; box-shadow: none !important; }
h1, h2, h3 { line-height: 1.15; color: var(--navy-950); }
p { line-height: 1.55; }
fieldset { min-width: 0; }
::selection { background: var(--brand-100); color: var(--navy-950); }
:focus-visible { outline: 3px solid rgba(20, 148, 138, .28); outline-offset: 3px; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

/* Authentication */
.auth-layout, .login-shell { min-height: 100vh; display: grid; grid-template-columns: minmax(440px, 39%) 1fr; }
.auth-panel, .login-panel { display: grid; place-items: center; padding: 48px; background: #fff; }
.auth-card, .login-card { width: min(480px, 100%); }
.auth-card-wide { width: min(740px, 100%); }
.auth-card h1, .login-card h1, .login-card h2 { margin: 36px 0 9px; font-size: clamp(2rem, 4vw, 2.5rem); letter-spacing: -.04em; }
.auth-card form, .login-card form { margin-top: 24px; }
.auth-brand { margin-bottom: 12px; }
.auth-links { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 24px; font-weight: 760; }
.auth-links a { color: var(--brand-700); text-decoration: none; text-underline-offset: 4px; }
.auth-links a:hover { text-decoration: underline; }
.auth-visual, .login-hero { position: relative; overflow: hidden; padding: clamp(44px, 6vw, 88px); display: flex; align-items: center; background: radial-gradient(circle at 78% 13%, rgba(41, 190, 177, .28), transparent 29%), radial-gradient(circle at 12% 92%, rgba(201, 151, 63, .16), transparent 25%), linear-gradient(138deg, var(--navy-950), var(--navy-800)); color: #fff; }
.auth-visual::after, .login-hero::after { content: ""; position: absolute; width: 420px; height: 420px; right: -210px; bottom: -210px; border: 1px solid rgba(255,255,255,.12); border-radius: 50%; box-shadow: 0 0 0 70px rgba(255,255,255,.025), 0 0 0 140px rgba(255,255,255,.02); }
.auth-visual > div, .login-hero > div { position: relative; z-index: 1; }
.auth-visual h2, .login-hero h1 { margin: 0; max-width: 900px; color: #fff; font-size: clamp(2.7rem, 5.2vw, 5rem); line-height: 1.03; letter-spacing: -.058em; }
.auth-visual p, .login-hero p { max-width: 720px; margin-top: 22px; color: #c9d9e5; font-size: 1.15rem; }
.auth-proof, .login-points { display: grid; gap: 12px; margin-top: 30px; }
.auth-proof span, .login-point { display: flex; align-items: center; gap: 11px; color: #edf6f7; font-weight: 760; }
.auth-proof span::before { content: "✓"; width: 28px; height: 28px; border-radius: 999px; display: grid; place-items: center; color: #fff; background: rgba(20, 148, 138, .42); border: 1px solid rgba(255,255,255,.18); }
.login-point span:first-child { width: 28px; height: 28px; border-radius: 999px; display: grid; place-items: center; background: rgba(20, 148, 138, .42); font-weight: 900; }
.login-card { background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 32px; box-shadow: var(--shadow); }
.eyebrow { color: var(--brand-700); font-size: .76rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }

.brand { display: flex; gap: 12px; align-items: center; }
.brand-mark { width: 46px; height: 46px; flex: 0 0 46px; border-radius: 13px; display: grid; place-items: center; background: linear-gradient(145deg, var(--brand-500), var(--brand-700)); color: #fff; font-size: 20px; box-shadow: 0 10px 26px rgba(15, 118, 110, .24); }
.brand strong, .brand span { display: block; }
.brand span { color: #7a8998; font-size: .8rem; margin-top: 3px; }

.role-fieldset { border: 0; padding: 0; margin: 24px 0 0; }
.role-fieldset legend { font-size: .95rem; font-weight: 850; margin-bottom: 10px; }
.role-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.role-option { position: relative; display: block; }
.role-option input { position: absolute; opacity: 0; pointer-events: none; }
.role-option-copy { min-height: 126px; display: grid; align-content: start; gap: 8px; padding: 19px; border: 1px solid var(--line); border-radius: 15px; background: #fff; cursor: pointer; transition: border-color var(--transition), background var(--transition), transform var(--transition), box-shadow var(--transition); }
.role-option-copy:hover { border-color: #a9c9c5; transform: translateY(-2px); box-shadow: var(--shadow-sm); }
.role-option-copy strong { font-size: 1.05rem; }
.role-option-copy small { color: var(--muted); line-height: 1.5; }
.role-option input:checked + .role-option-copy { border-color: var(--brand-600); background: var(--brand-50); box-shadow: 0 0 0 3px rgba(20, 148, 138, .12); }
.role-option input:focus-visible + .role-option-copy { outline: 3px solid rgba(20,148,138,.24); outline-offset: 3px; }
.verification-panel { margin-top: 18px; border: 1px solid var(--line); border-radius: 15px; padding: 16px 18px 20px; background: var(--surface-subtle); }
.verification-panel summary { cursor: pointer; color: var(--brand-700); font-weight: 850; }
.status-screen { background: radial-gradient(circle at 20% 15%, rgba(20,148,138,.12), transparent 28%), linear-gradient(145deg, #f5f8f9, #eaf1f3); }
.center-screen { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
.status-card { width: min(560px, 100%); padding: 34px; background: rgba(255,255,255,.96); border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow-lg); text-align: center; }
.status-card .brand { justify-content: center; text-align: left; }
.status-symbol { width: 66px; height: 66px; margin: 30px auto 18px; border-radius: 999px; display: grid; place-items: center; background: var(--amber-soft); color: var(--amber); font-size: 2rem; font-weight: 950; }
.status-approved { background: var(--green-soft); color: var(--green); }
.status-rejected { background: var(--red-soft); color: var(--red); }
.status-actions { display: grid; gap: 10px; margin-top: 18px; }

/* Application shell */
.application-shell { min-height: 100vh; display: grid; grid-template-columns: 274px minmax(0, 1fr); }
.sidebar { position: sticky; top: 0; z-index: 30; height: 100vh; overflow-y: auto; padding: 24px 18px; display: flex; flex-direction: column; color: #fff; background: linear-gradient(180deg, var(--navy-950) 0%, var(--navy-900) 58%, #0c2a3d 100%); box-shadow: 8px 0 28px rgba(7, 26, 43, .08); }
.sidebar .brand { padding: 0 7px 20px; }
.sidebar .brand-mark { box-shadow: none; }
.sidebar .brand span { color: #9fb2c2; }
.sidebar-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.sidebar-close { display: none; color: #fff; font-size: 1.6rem; }
.sidebar nav { display: grid; gap: 6px; margin-top: 22px; }
.nav-link { min-height: 46px; display: flex; align-items: center; gap: 12px; padding: 11px 13px; border-radius: 11px; color: #cbd8e2; text-decoration: none; font-size: .93rem; font-weight: 760; transition: background var(--transition), color var(--transition), transform var(--transition); }
.nav-link svg { width: 20px; height: 20px; flex: 0 0 20px; }
.nav-link:hover, .nav-link:focus-visible { background: rgba(255,255,255,.08); color: #fff; transform: translateX(2px); }
.nav-link.active { background: linear-gradient(135deg, rgba(20,148,138,.98), rgba(15,118,110,.98)); color: #fff; box-shadow: 0 9px 24px rgba(0, 0, 0, .2); }
.sidebar-account { margin-top: auto; padding: 18px 8px 0; border-top: 1px solid rgba(255,255,255,.13); }
.sidebar-account span, .sidebar-account small { display: block; color: #9fb2c2; }
.sidebar-account strong { display: block; margin: 4px 0; }
.sidebar-account small { text-transform: capitalize; }
.sidebar-account form { margin-top: 12px; }
.sidebar-signout { width: 100%; min-height: 40px; display: flex; align-items: center; gap: 9px; padding: 10px 0; border: 0; background: transparent; color: #d8e4ea; font-weight: 760; text-align: left; transition: color var(--transition), transform var(--transition); }
.sidebar-signout:hover { color: #fff; transform: translateX(2px); }
.sidebar-signout svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.sidebar-scrim { display: none; }
.workspace { min-width: 0; }
.workspace-header { position: sticky; top: 0; z-index: 20; height: 86px; display: flex; align-items: center; gap: 15px; padding: 18px 28px; border-bottom: 1px solid rgba(217,225,232,.9); background: rgba(255,255,255,.91); backdrop-filter: blur(14px); }
.workspace-header h1 { margin: 0; font-size: 1.38rem; letter-spacing: -.025em; }
.workspace-header p { margin: 4px 0 0; color: #738395; font-size: .9rem; text-transform: capitalize; }
.workspace-mark { margin-left: auto; width: 36px; height: 36px; display: grid; place-items: center; border-radius: 11px; color: var(--brand-700); background: var(--brand-100); font-size: 1rem; }
.main-content { width: 100%; max-width: 1550px; margin-inline: auto; padding: 28px; }
.icon-button { width: 40px; height: 40px; border: 0; border-radius: 10px; display: inline-grid; place-items: center; background: transparent; color: inherit; transition: background var(--transition), transform var(--transition); }
.icon-button:hover { background: var(--brand-100); transform: translateY(-1px); }
.icon-button svg { width: 23px; height: 23px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
.mobile-menu { display: none; }

/* Shared product UI */
.page-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; margin-bottom: 22px; }
.page-header h1 { margin: 0; font-size: 1.9rem; letter-spacing: -.038em; }
.page-header h2, .page-header h3 { margin: 0; }
.page-header p { margin: 7px 0 0; color: var(--muted); }
.grid { display: grid; gap: 18px; }
.grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.card, .panel { min-width: 0; padding: 20px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); box-shadow: var(--shadow-sm); transition: border-color var(--transition), box-shadow var(--transition); }
.card:hover, .panel:hover { border-color: var(--line-strong); box-shadow: 0 9px 26px rgba(7, 26, 43, .07); }
.card h2, .card h3, .panel h2, .panel h3 { margin-top: 0; }
.ministry-hero { position: relative; overflow: hidden; padding: clamp(28px, 4vw, 42px); border-radius: 22px; color: #fff; background: radial-gradient(circle at 86% 12%, rgba(37, 185, 170, .3), transparent 28%), radial-gradient(circle at 8% 100%, rgba(201,151,63,.15), transparent 26%), linear-gradient(135deg, var(--navy-950), var(--navy-700)); box-shadow: var(--shadow); }
.ministry-hero::after { content: "✦"; position: absolute; right: 34px; bottom: 9px; color: rgba(255,255,255,.09); font-size: 8rem; }
.ministry-hero h2 { max-width: 780px; margin: 0; color: #fff; font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -.047em; }
.ministry-hero p { max-width: 720px; margin: 12px 0 0; color: #c9d9e5; }
.ministry-hero .actions { position: relative; z-index: 1; margin-top: 22px; }
.metric { display: flex; justify-content: space-between; gap: 14px; }
.metric-label { color: var(--muted); font-weight: 730; font-size: .9rem; }
.metric-value { margin-top: 8px; color: var(--navy-950); font-size: 2rem; font-weight: 950; }
.metric-icon { width: 44px; height: 44px; flex: 0 0 44px; border-radius: 13px; display: grid; place-items: center; color: var(--brand-700); background: var(--brand-100); font-size: 20px; font-weight: 900; }
.metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 16px; margin: 18px 0; }
.metric-grid article { min-width: 0; display: grid; gap: 9px; padding: 20px; border: 1px solid var(--line); border-radius: 16px; background: #fff; box-shadow: var(--shadow-sm); transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition); }
.metric-grid article:hover { transform: translateY(-2px); border-color: #b9d3d0; box-shadow: 0 12px 30px rgba(7,26,43,.08); }
.metric-grid span { color: var(--muted); }
.metric-grid strong { color: var(--navy-950); font-size: 2rem; }
.metric-symbol { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 12px; background: var(--brand-100); color: var(--brand-700); font-weight: 950; }
.field { display: grid; gap: 7px; margin-top: 16px; }
.field:first-child { margin-top: 0; }
label, legend { font-size: .92rem; font-weight: 800; }
input, select, textarea { width: 100%; border: 1px solid var(--line-strong); background: #fff; color: var(--ink); border-radius: 11px; padding: 12px 14px; outline: none; transition: border-color var(--transition), box-shadow var(--transition), background var(--transition); }
input:hover, select:hover, textarea:hover { border-color: #aebdc9; }
input:focus, select:focus, textarea:focus { border-color: var(--brand-500); box-shadow: 0 0 0 3px rgba(20,148,138,.13); }
input:disabled, select:disabled, textarea:disabled { background: #eef2f4; color: #7a8997; }
textarea { min-height: 118px; resize: vertical; }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
.checkbox-row { display: flex; gap: 10px; align-items: flex-start; margin-top: 16px; }
.checkbox-row input { width: auto; margin-top: 3px; accent-color: var(--brand-600); }
.button { min-height: 44px; border: 0; border-radius: 11px; padding: 11px 16px; font-weight: 850; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; transition: transform var(--transition), background var(--transition), border-color var(--transition), box-shadow var(--transition), color var(--transition); }
.button:hover { transform: translateY(-1px); }
.button:active { transform: translateY(0); }
.button-primary { color: #fff; background: linear-gradient(135deg, var(--brand-500), var(--brand-700)); box-shadow: 0 8px 20px rgba(15,118,110,.2); }
.button-primary:hover { background: linear-gradient(135deg, #11877f, var(--brand-700)); box-shadow: 0 11px 25px rgba(15,118,110,.26); }
.button-secondary { color: var(--navy-800); background: #fff; border: 1px solid var(--line-strong); box-shadow: 0 2px 5px rgba(7,26,43,.03); }
.button-secondary:hover { background: var(--brand-50); border-color: #9fc3bf; color: var(--brand-700); }
.button-danger { background: var(--red); color: #fff; box-shadow: 0 7px 18px rgba(163,58,67,.18); }
.button-danger:hover { background: #8f3039; box-shadow: 0 10px 24px rgba(163,58,67,.24); }
.button-full { width: 100%; }
.button-small { min-height: 36px; padding: 7px 10px; font-size: .86rem; }
.button[aria-disabled="true"]::before, .sidebar-signout[aria-disabled="true"]::before { content: ""; width: 14px; height: 14px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin .7s linear infinite; }
.actions, .action-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.action-row { justify-content: flex-end; }
.stack { display: grid; gap: 16px; }
.notice { border-radius: 11px; padding: 12px 14px; margin: 14px 0; font-weight: 700; }
.notice-success { background: var(--green-soft); color: var(--green); border: 1px solid #c7ead6; }
.notice-error { background: var(--red-soft); color: var(--red); border: 1px solid #f1cbd0; }
.notice-info { background: var(--brand-50); color: var(--brand-700); border: 1px solid #c9e8e4; }
.table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 13px; background: #fff; }
table { width: 100%; min-width: 760px; border-collapse: collapse; }
th, td { text-align: left; padding: 13px 14px; border-bottom: 1px solid #e9eef2; vertical-align: middle; }
th { background: #f6f8f9; color: #687989; font-size: .76rem; text-transform: uppercase; letter-spacing: .06em; }
tbody tr { transition: background var(--transition); }
tbody tr:hover { background: #fbfdfd; }
tr:last-child td { border-bottom: 0; }
.badge { display: inline-flex; align-items: center; border-radius: 999px; padding: 5px 9px; font-size: .75rem; font-weight: 900; }
.badge-success { background: var(--green-soft); color: var(--green); }
.badge-warning { background: var(--amber-soft); color: var(--amber); }
.badge-neutral { background: #edf1f4; color: #526476; }
.badge-danger { background: var(--red-soft); color: var(--red); }
.muted { color: var(--muted); }
.small { font-size: .86rem; }
.divider { border: 0; border-top: 1px solid var(--line); margin: 22px 0; }
.toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; margin-bottom: 16px; }
.toolbar .grow { flex: 1; min-width: 230px; }
.empty { text-align: center; color: var(--muted); padding: 32px 18px; }
.service-banner { background: linear-gradient(135deg, #f0faf8, #eef4f6); border: 1px solid #cbe3e0; border-radius: var(--radius); padding: 20px; display: flex; justify-content: space-between; gap: 18px; align-items: center; margin-bottom: 18px; }
.service-banner h2 { margin: 5px 0; }
.danger-zone { border-color: #efc8cd; }
.code-box { overflow: auto; background: var(--navy-950); color: #eaf4f5; padding: 14px; border-radius: 11px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .86rem; }
.current-account { display: inline-flex; align-items: center; min-height: 36px; padding: 7px 10px; border-radius: 9px; color: var(--muted); background: #f1f4f6; font-size: .84rem; font-weight: 800; }

/* Attendance, people and care */
.service-bar { display: flex; align-items: end; justify-content: space-between; gap: 20px; }
.counter-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 18px; margin-top: 18px; }
.counter { border-radius: 20px; padding: 24px; display: grid; gap: 10px; text-align: center; border: 1px solid var(--line); box-shadow: var(--shadow-sm); }
.counter strong { font-size: 4rem; }
.counter.new { background: #eff9f3; color: #177243; }
.counter.returning { background: #eef5fa; color: #245f91; }
.counter.total { background: #f5f2e9; color: #8a6426; }
.people-layout, .care-layout { display: grid; grid-template-columns: minmax(330px, 40%) minmax(0, 1fr); gap: 18px; }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.section-heading p { color: var(--muted); }
.search { display: flex; align-items: center; gap: 8px; border: 1px solid var(--line); border-radius: 11px; padding: 0 12px; background: #fff; }
.search:focus-within { border-color: var(--brand-500); box-shadow: 0 0 0 3px rgba(20,148,138,.12); }
.search input { border: 0; box-shadow: none; }
.rows { display: grid; gap: 8px; margin-top: 14px; }
.rows > a, .rows > button, .care-person-row { width: 100%; border: 1px solid #e0e6eb; background: #fff; border-radius: 11px; padding: 13px; text-align: left; display: flex; justify-content: space-between; gap: 14px; align-items: center; color: inherit; text-decoration: none; transition: border-color var(--transition), background var(--transition), transform var(--transition), box-shadow var(--transition); }
.rows > a:hover, .rows > button:hover, .care-person-row:hover { border-color: #9fc5c1; background: var(--brand-50); transform: translateX(2px); box-shadow: var(--shadow-sm); }
.rows > a.selected, .rows > button.selected, .care-person-row.selected { border-color: var(--brand-600); background: var(--brand-50); box-shadow: inset 3px 0 0 var(--brand-600); }
.rows strong, .rows small { display: block; }
.rows small { color: var(--muted); margin-top: 4px; }
.care-timeline { display: grid; gap: 11px; margin-top: 18px; }
.care-entry { padding: 15px; border: 1px solid #e2e8ec; border-radius: 12px; background: #f9fbfb; }
.care-entry p { margin: 8px 0; white-space: pre-wrap; }
.care-entry-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; color: var(--muted); font-size: .82rem; }
.detail-tabs { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 16px; margin-top: 18px; }

/* Imports and admin */
.import-card { text-align: center; }
.import-drop { display: grid; place-items: center; gap: 8px; margin: 22px 0; padding: 34px 20px; border: 2px dashed #9ecbc6; border-radius: 16px; background: var(--brand-50); cursor: pointer; transition: border-color var(--transition), background var(--transition), transform var(--transition); }
.import-drop:hover { border-color: var(--brand-600); background: #e8f7f4; transform: translateY(-1px); }
.import-drop input { width: min(420px, 100%); background: #fff; }
.import-preview { margin-top: 24px; text-align: left; }
.import-summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 12px; }
.admin-summary { display: grid; text-align: center; padding: 32px; }
.admin-summary strong { font-size: 4rem; color: var(--brand-700); }
.application-card { border-left: 4px solid var(--brand-600); }
.application-details { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 12px; margin: 16px 0; }
.application-details div { padding: 11px; border-radius: 10px; background: #f6f9f9; border: 1px solid #edf1f2; }
.application-details small, .application-details strong { display: block; }
.application-details small { color: var(--muted); margin-bottom: 3px; }

@keyframes spin { to { transform: rotate(360deg); } }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}

@media (max-width: 1180px) {
  .grid-4, .metric-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .grid-3 { grid-template-columns: repeat(2, minmax(0,1fr)); }
}

@media (max-width: 900px) {
  .auth-layout, .login-shell { grid-template-columns: 1fr; }
  .auth-visual, .login-hero { display: none; }
  .auth-panel, .login-panel { min-height: 100vh; padding: 30px 22px; }
  .application-shell { grid-template-columns: 1fr; }
  .sidebar { position: fixed; inset: 0 auto 0 0; width: min(310px, 88vw); transform: translateX(-105%); transition: transform .2s ease; box-shadow: 18px 0 45px rgba(7,26,43,.28); }
  .sidebar.open { transform: translateX(0); }
  .sidebar-close, .mobile-menu { display: inline-grid; }
  .sidebar-scrim { position: fixed; inset: 0; z-index: 25; border: 0; background: rgba(7,26,43,.56); }
  .sidebar-scrim.visible { display: block; }
  .workspace-header { padding: 15px 18px; }
  .main-content { padding: 18px; }
  .people-layout, .care-layout, .grid-2, .form-grid, .detail-tabs { grid-template-columns: 1fr; }
  .counter-grid { grid-template-columns: 1fr; }
  .page-header, .service-banner, .service-bar { flex-direction: column; align-items: stretch; }
  .application-details { grid-template-columns: repeat(2, minmax(0,1fr)); }
}

@media (max-width: 580px) {
  .auth-panel, .login-panel { padding: 24px 17px; }
  .auth-card h1, .login-card h1, .login-card h2 { font-size: 1.8rem; }
  .role-grid, .grid-3, .grid-4, .metric-grid { grid-template-columns: 1fr; }
  .main-content { padding: 13px; }
  .workspace-header { height: 78px; }
  .workspace-mark { display: none; }
  .ministry-hero { border-radius: 17px; padding: 25px 21px; }
  .ministry-hero::after { display: none; }
  .actions .button, .action-row .button { width: 100%; }
  .auth-links, .import-summary { align-items: stretch; flex-direction: column; }
  .application-details { grid-template-columns: 1fr; }
  .status-card { padding: 26px 20px; }
}
