:root {
  --purple-950: #24105f;
  --purple-900: #351475;
  --purple-800: #4a249b;
  --purple-700: #5b32c7;
  --purple-600: #6b3dde;
  --purple-500: #7a49eb;
  --purple-400: #966cf0;
  --purple-200: #dcd0ff;
  --purple-100: #eee8ff;
  --purple-50: #f7f3ff;
  --ink: #17213a;
  --muted: #737d94;
  --line: #e2e5ef;
  --line-strong: #d5d9e6;
  --background: #f5f7ff;
  --card: #ffffff;
  --green: #157a43;
  --green-soft: #e9f9ef;
  --amber: #8a5a00;
  --amber-soft: #fff6dc;
  --red: #a12f3b;
  --red-soft: #fff0f1;
  --blue: #2464d6;
  --blue-soft: #edf4ff;
  --radius-sm: 12px;
  --radius: 18px;
  --radius-lg: 24px;
  --shadow-sm: 0 5px 20px rgba(30, 38, 71, 0.045);
  --shadow: 0 12px 34px rgba(43, 31, 91, 0.08);
  --shadow-lg: 0 24px 70px rgba(45, 36, 98, 0.14);
}

* { box-sizing: border-box; }
html {
  min-width: 320px;
  background: var(--background);
  color: var(--ink);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  text-rendering: optimizeLegibility;
}
body { margin: 0; min-width: 320px; min-height: 100vh; background: var(--background); }
a { color: inherit; }
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
button:disabled { cursor: not-allowed; opacity: .64; }
h1, h2, h3 { line-height: 1.15; color: var(--ink); }
p { line-height: 1.58; }
fieldset { min-width: 0; }
::selection { background: var(--purple-200); color: var(--purple-950); }
:focus-visible { outline: 3px solid rgba(107, 61, 222, .28); outline-offset: 2px; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

/* Authentication */
.auth-layout,
.login-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: minmax(430px, 38%) 1fr;
  background: #fff;
}
.auth-panel,
.login-panel {
  display: grid;
  place-items: center;
  padding: clamp(32px, 5vw, 58px);
  background: #fff;
}
.auth-card,
.login-card { width: min(480px, 100%); }
.role-signup-card,
.auth-card-wide { width: min(760px, 100%); }
.login-card {
  padding: clamp(24px, 4vw, 36px);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: #fff;
  box-shadow: var(--shadow);
}
.auth-card h1,
.login-card h1,
.login-card h2 {
  margin: 34px 0 9px;
  font-size: clamp(2rem, 4vw, 2.45rem);
  letter-spacing: -.038em;
}
.auth-card form,
.login-card form { margin-top: 24px; }
.auth-links { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 24px; font-weight: 760; }
.auth-links a,
.login-card a:not(.button) { color: var(--purple-700); text-decoration: none; font-weight: 760; }
.auth-links a:hover,
.login-card a:not(.button):hover { text-decoration: underline; }
.auth-visual,
.login-hero {
  position: relative;
  overflow: hidden;
  padding: clamp(44px, 7vw, 90px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  background:
    radial-gradient(circle at 78% 14%, rgba(166, 127, 255, .44), transparent 28%),
    radial-gradient(circle at 20% 86%, rgba(107, 61, 222, .32), transparent 34%),
    linear-gradient(135deg, rgba(53, 20, 117, .99), rgba(101, 49, 215, .96));
  color: #fff;
}
.login-hero::after {
  content: "✦";
  position: absolute;
  right: clamp(26px, 5vw, 76px);
  bottom: clamp(12px, 4vw, 44px);
  color: rgba(255,255,255,.08);
  font-size: clamp(9rem, 22vw, 20rem);
  line-height: 1;
}
.auth-visual h2,
.login-hero h1 {
  position: relative;
  z-index: 1;
  margin: 0;
  max-width: 900px;
  color: #fff;
  font-size: clamp(2.75rem, 5.2vw, 5rem);
  line-height: 1.03;
  letter-spacing: -.058em;
}
.auth-visual p,
.login-hero p {
  position: relative;
  z-index: 1;
  max-width: 720px;
  margin-top: 22px;
  color: #ded9fb;
  font-size: 1.12rem;
}
.auth-proof,
.login-points { position: relative; z-index: 1; display: grid; gap: 13px; margin-top: 30px; }
.auth-proof span,
.login-point { display: flex; align-items: center; gap: 11px; color: #fff; font-weight: 760; }
.login-point span:first-child,
.auth-proof span::before {
  width: 29px;
  height: 29px;
  flex: 0 0 29px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  background: rgba(255,255,255,.14);
  font-weight: 900;
}
.auth-proof span::before { content: "✓"; }
.eyebrow { color: var(--purple-700); font-size: .77rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }

.brand { display: flex; gap: 12px; align-items: center; }
.brand-mark {
  width: 46px;
  height: 46px;
  flex: 0 0 46px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--purple-500), var(--purple-700));
  color: #fff;
  font-size: 21px;
  box-shadow: 0 9px 24px rgba(91, 50, 199, .28);
}
.brand strong,
.brand span { display: block; }
.brand strong { letter-spacing: -.015em; }
.brand span { margin-top: 3px; color: #8a92a8; font-size: .8rem; }
.auth-brand { margin-bottom: 12px; }

.role-picker,
.role-fieldset { border: 0; padding: 0; margin: 24px 0 20px; }
.role-picker legend,
.role-fieldset legend { margin-bottom: 11px; font-size: .95rem; font-weight: 850; }
.role-grid,
.role-picker { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; }
.role-picker legend { grid-column: 1 / -1; }
.role-option { position: relative; display: block; }
.role-option > input { position: absolute; opacity: 0; pointer-events: none; }
.role-option > span,
.role-option-copy {
  min-height: 132px;
  display: grid;
  align-content: start;
  gap: 8px;
  padding: 19px;
  border: 1px solid #dcdfea;
  border-radius: 17px;
  background: #fff;
  cursor: pointer;
  transition: border-color .18s ease, background .18s ease, transform .18s ease, box-shadow .18s ease;
}
.role-option:hover > span,
.role-option:hover .role-option-copy { transform: translateY(-2px); border-color: var(--purple-400); box-shadow: 0 10px 26px rgba(63, 42, 126, .08); }
.role-option strong { font-size: 1.02rem; }
.role-option small { color: var(--muted); line-height: 1.5; }
.role-option input:checked + span,
.role-option input:checked + .role-option-copy { border-color: var(--purple-600); background: var(--purple-50); box-shadow: 0 0 0 3px rgba(107, 61, 222, .12); }
.role-option input:focus-visible + span,
.role-option input:focus-visible + .role-option-copy { outline: 3px solid rgba(107,61,222,.24); outline-offset: 2px; }
.pastor-details,
.verification-panel {
  margin: 0 0 20px;
  padding: 16px 18px 20px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: #fbfbfe;
}
.pastor-details summary,
.verification-panel summary { cursor: pointer; color: var(--purple-700); font-weight: 850; }

.status-screen { background: linear-gradient(145deg, #f6f3ff, #eef2ff); }
.center-screen { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
.status-card { width: min(560px, 100%); padding: 34px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: #fff; box-shadow: var(--shadow-lg); text-align: center; }
.status-card .brand { justify-content: center; text-align: left; }
.status-symbol { width: 66px; height: 66px; margin: 30px auto 18px; border-radius: 999px; display: grid; place-items: center; background: var(--amber-soft); color: var(--amber); font-size: 2rem; font-weight: 950; }
.status-approved { background: var(--green-soft); color: var(--green); }
.status-rejected { background: var(--red-soft); color: var(--red); }

/* Application shell */
.application-shell { min-height: 100vh; display: grid; grid-template-columns: 276px minmax(0, 1fr); }
.sidebar {
  position: sticky;
  top: 0;
  z-index: 30;
  height: 100vh;
  overflow-y: auto;
  padding: 24px 18px;
  display: flex;
  flex-direction: column;
  color: #fff;
  background: linear-gradient(180deg, #351475 0%, #2b1c70 54%, #282069 100%);
}
.sidebar .brand { padding: 0 7px 20px; }
.sidebar .brand-mark { box-shadow: none; }
.sidebar .brand strong { color: #fff; }
.sidebar .brand span { color: #c8c4e9; }
.sidebar-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.sidebar-close { display: none; color: #fff; font-size: 1.6rem; }
.sidebar-role {
  margin: 0 6px 18px;
  padding: 13px 14px;
  border: 1px solid rgba(255,255,255,.11);
  border-radius: 13px;
  background: rgba(255,255,255,.07);
}
.sidebar-role strong,
.sidebar-role small { display: block; }
.sidebar-role strong { color: #fff; font-size: .87rem; }
.sidebar-role small { margin-top: 5px; color: #c9c5e9; font-size: .78rem; line-height: 1.45; }
.sidebar nav { display: grid; gap: 6px; }
.nav-link {
  min-height: 46px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 13px;
  border-radius: 11px;
  color: #dfddf4;
  text-decoration: none;
  font-size: .92rem;
  font-weight: 760;
  transition: background .16s ease, color .16s ease, transform .16s ease;
}
.nav-link svg { width: 20px; height: 20px; flex: 0 0 20px; }
.nav-link:hover,
.nav-link:focus-visible { background: rgba(255,255,255,.1); color: #fff; transform: translateX(2px); }
.nav-link.active { background: linear-gradient(135deg, #7545e8, #5a32d3); color: #fff; box-shadow: 0 8px 22px rgba(21, 11, 70, .24); }
.sidebar-account { margin-top: auto; padding: 18px 8px 0; border-top: 1px solid rgba(255,255,255,.15); }
.sidebar-account span,
.sidebar-account small { display: block; color: #bebbe0; }
.sidebar-account strong { display: block; margin: 4px 0; color: #fff; }
.sidebar-account small { text-transform: capitalize; }
.sidebar-account form { margin-top: 12px; }
.sidebar-signout { width: 100%; display: flex; align-items: center; gap: 9px; padding: 10px 0; border: 0; background: transparent; color: #e5e3f7; font-weight: 760; text-align: left; }
.sidebar-signout:hover { color: #fff; }
.sidebar-signout svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.sidebar-scrim { display: none; }
.workspace { min-width: 0; }
.workspace-header {
  position: sticky;
  top: 0;
  z-index: 20;
  min-height: 86px;
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 17px 28px;
  border-bottom: 1px solid #e6e8f0;
  background: rgba(255,255,255,.95);
  backdrop-filter: blur(14px);
}
.workspace-header h1 { margin: 0; font-size: 1.42rem; letter-spacing: -.028em; }
.workspace-header p { margin: 4px 0 0; color: #858da1; font-size: .88rem; }
.workspace-mark { margin-left: auto; color: var(--purple-600); font-size: 1.5rem; }
.main-content { width: 100%; max-width: 1550px; margin-inline: auto; padding: 28px; }
.icon-button { width: 40px; height: 40px; border: 0; border-radius: 10px; display: inline-grid; place-items: center; background: transparent; color: inherit; }
.icon-button:hover { background: rgba(107,61,222,.08); }
.icon-button svg { width: 23px; height: 23px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.mobile-menu { display: none; }

/* Shared product UI */
.page-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; margin-bottom: 22px; }
.page-header h1 { margin: 0; font-size: clamp(1.75rem, 2vw, 2rem); letter-spacing: -.038em; }
.page-header h2,
.page-header h3 { margin: 0; }
.page-header p { max-width: 820px; margin: 7px 0 0; color: var(--muted); }
.grid { display: grid; gap: 18px; }
.grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.card,
.panel {
  min-width: 0;
  padding: 21px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--card);
  box-shadow: var(--shadow-sm);
}
.card h2,
.card h3,
.panel h2,
.panel h3 { margin-top: 0; letter-spacing: -.02em; }
.card > :last-child,
.panel > :last-child { margin-bottom: 0; }
.ministry-hero {
  position: relative;
  overflow: hidden;
  padding: clamp(29px, 4vw, 44px);
  border-radius: var(--radius-lg);
  color: #fff;
  background: radial-gradient(circle at 85% 10%, rgba(164,124,255,.46), transparent 28%), linear-gradient(135deg, #37147a, #7141e4);
  box-shadow: 0 20px 46px rgba(65, 35, 143, .18);
}
.ministry-hero::after { content: "✦"; position: absolute; right: 34px; bottom: 9px; color: rgba(255,255,255,.12); font-size: 8rem; }
.ministry-hero h1,
.ministry-hero h2 { position: relative; z-index: 1; max-width: 820px; margin: 0; color: #fff; font-size: clamp(2rem, 4vw, 3.05rem); letter-spacing: -.047em; }
.ministry-hero p { position: relative; z-index: 1; max-width: 760px; margin: 13px 0 0; color: #ded9fb; }
.ministry-hero .actions { position: relative; z-index: 1; margin-top: 23px; }
.metric { display: flex; justify-content: space-between; gap: 14px; }
.metric-label { color: var(--muted); font-weight: 730; font-size: .89rem; }
.metric-value { margin-top: 8px; font-size: 2rem; font-weight: 950; letter-spacing: -.04em; }
.metric-icon,
.metric-symbol { width: 44px; height: 44px; flex: 0 0 44px; border-radius: 14px; display: grid; place-items: center; color: var(--purple-700); background: var(--purple-100); font-size: 20px; font-weight: 900; }
.metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 16px; margin: 18px 0; }
.metric-grid article { min-width: 0; display: grid; gap: 9px; padding: 20px; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; box-shadow: 0 8px 26px rgba(37,45,80,.05); }
.metric-grid span { color: var(--muted); }
.metric-grid strong { font-size: 2rem; letter-spacing: -.04em; }
.field { display: grid; gap: 7px; margin-top: 16px; }
.field:first-child { margin-top: 0; }
label,
legend { color: #303a52; font-size: .91rem; font-weight: 800; }
input,
select,
textarea {
  width: 100%;
  min-height: 46px;
  border: 1px solid #d8dce7;
  background: #fff;
  color: var(--ink);
  border-radius: 12px;
  padding: 12px 14px;
  outline: none;
  transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
}
textarea { min-height: 104px; resize: vertical; }
input:hover,
select:hover,
textarea:hover { border-color: #c6cada; }
input:focus,
select:focus,
textarea:focus { border-color: var(--purple-600); box-shadow: 0 0 0 3px rgba(107,61,222,.13); }
input[type="file"] { padding: 10px; background: #fbfbfe; }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
.checkbox-row { display: flex; gap: 10px; align-items: flex-start; margin-top: 16px; }
.checkbox-row input { width: auto; min-height: auto; margin-top: 3px; }
.button {
  min-height: 44px;
  border: 0;
  border-radius: 12px;
  padding: 11px 16px;
  font-weight: 850;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-decoration: none;
  transition: transform .15s ease, box-shadow .15s ease, background .15s ease, border-color .15s ease;
}
.button:hover { transform: translateY(-1px); }
.button-primary { background: linear-gradient(135deg, var(--purple-600), var(--purple-700)); color: #fff; box-shadow: 0 8px 20px rgba(91,50,199,.20); }
.button-primary:hover { background: linear-gradient(135deg, var(--purple-500), var(--purple-700)); box-shadow: 0 11px 26px rgba(91,50,199,.25); }
.button-secondary { border: 1px solid var(--line-strong); background: #fff; color: var(--ink); }
.button-secondary:hover { border-color: var(--purple-400); color: var(--purple-800); background: var(--purple-50); }
.button-danger { background: var(--red); color: #fff; }
.button-full { width: 100%; }
.button-small { min-height: 36px; padding: 7px 10px; font-size: .84rem; }
.actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.stack { display: grid; gap: 16px; }
.notice { border-radius: 12px; padding: 12px 14px; margin: 14px 0; border: 1px solid transparent; font-weight: 700; }
.notice-success { background: var(--green-soft); color: var(--green); border-color: #cdeed9; }
.notice-error { background: var(--red-soft); color: var(--red); border-color: #f5d4d8; }
.notice-info { background: var(--purple-50); color: var(--purple-800); border-color: var(--purple-200); }
.table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 14px; background: #fff; }
table { width: 100%; min-width: 760px; border-collapse: collapse; }
th,
td { text-align: left; padding: 13px 14px; border-bottom: 1px solid #edf0f6; vertical-align: middle; }
th { background: #f8f8fc; color: #6c7489; font-size: .76rem; text-transform: uppercase; letter-spacing: .06em; }
tbody tr { transition: background .12s ease; }
tbody tr:hover { background: #fbfaff; }
tr:last-child td { border-bottom: 0; }
.badge { display: inline-flex; align-items: center; border-radius: 999px; padding: 5px 9px; font-size: .74rem; font-weight: 900; text-transform: capitalize; }
.badge-success { background: var(--green-soft); color: var(--green); }
.badge-warning { background: var(--amber-soft); color: var(--amber); }
.badge-neutral { background: #eef0f5; color: #525d73; }
.badge-danger { background: var(--red-soft); color: var(--red); }
.muted { color: var(--muted); }
.small { font-size: .85rem; }
.divider { border: 0; border-top: 1px solid var(--line); margin: 22px 0; }
.toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; margin-bottom: 16px; }
.toolbar .grow { flex: 1; min-width: 230px; }
.empty { text-align: center; color: var(--muted); padding: 34px 18px; }
.service-banner {
  border: 1px solid var(--purple-200);
  border-radius: var(--radius);
  padding: 20px;
  display: flex;
  justify-content: space-between;
  gap: 18px;
  align-items: center;
  margin-bottom: 18px;
  background: linear-gradient(135deg, #fbf9ff, #f0edff);
}
.service-banner h2 { margin: 5px 0; }
.danger-zone { border-color: #f3cbd0; }
.code-box { overflow: auto; margin: 14px 0; background: #201342; color: #ece8ff; padding: 15px; border-radius: 12px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .84rem; line-height: 1.55; }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.section-heading p { color: var(--muted); }

/* Care, directory, import and administration */
.care-layout { display: grid; grid-template-columns: minmax(300px, .78fr) minmax(0, 1.55fr); gap: 18px; align-items: start; }
.care-directory { position: sticky; top: 105px; }
.person-result { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 13px; border: 1px solid var(--line); border-radius: 12px; background: #fff; text-decoration: none; transition: border-color .15s ease, background .15s ease, transform .15s ease; }
.person-result:hover,
.person-result-active { border-color: var(--purple-500); background: var(--purple-50); transform: translateY(-1px); }
.person-result strong,
.person-result small { display: block; }
.person-result small { margin-top: 4px; color: var(--muted); }
.timeline { display: grid; gap: 14px; }
.timeline article { position: relative; padding: 0 0 0 18px; border-left: 3px solid var(--purple-200); }
.timeline article::before { content: ""; position: absolute; left: -7px; top: 3px; width: 11px; height: 11px; border-radius: 999px; background: var(--purple-600); box-shadow: 0 0 0 4px var(--purple-100); }
.timeline article + article { padding-top: 14px; border-top: 1px solid var(--line); }
.admin-module { display: block; position: relative; overflow: hidden; text-decoration: none; transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease; }
.admin-module::after { content: "→"; position: absolute; right: 18px; top: 18px; color: var(--purple-600); font-weight: 900; }
.admin-module:hover { transform: translateY(-3px); border-color: var(--purple-200); box-shadow: var(--shadow); }
.admin-module .metric-value { color: var(--purple-800); }
.role-request { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .8fr); gap: 20px; }
.application-card { border-left: 4px solid var(--purple-600); }
.application-details { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 12px; margin: 16px 0; }
.application-details div { padding: 11px; border-radius: 11px; background: #f8f7fc; }
.application-details small,
.application-details strong { display: block; }
.application-details small { margin-bottom: 3px; color: var(--muted); }
.import-preview { max-height: 430px; overflow: auto; }
.import-summary { display: flex; align-items: center; justify-content: space-between; gap: 14px; }

@media (max-width: 1180px) {
  .grid-4,
  .metric-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .grid-3 { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .role-grid,
  .role-picker { grid-template-columns: repeat(2, minmax(0,1fr)); }
}

@media (max-width: 900px) {
  .auth-layout,
  .login-shell { grid-template-columns: 1fr; }
  .auth-visual,
  .login-hero { display: none; }
  .auth-panel,
  .login-panel { min-height: 100vh; padding: 30px 22px; }
  .application-shell { grid-template-columns: 1fr; }
  .sidebar { position: fixed; inset: 0 auto 0 0; width: min(310px, 88vw); transform: translateX(-105%); transition: transform .2s ease; box-shadow: 18px 0 45px rgba(20,12,55,.25); }
  .sidebar.open { transform: translateX(0); }
  .sidebar-close,
  .mobile-menu { display: inline-grid; }
  .sidebar-scrim { position: fixed; inset: 0; z-index: 25; border: 0; background: rgba(16,12,37,.48); }
  .sidebar-scrim.visible { display: block; }
  .workspace-header { padding: 15px 18px; }
  .main-content { padding: 18px; }
  .care-layout,
  .grid-2,
  .form-grid,
  .role-request { grid-template-columns: 1fr; }
  .care-directory { position: static; }
  .page-header,
  .service-banner { flex-direction: column; align-items: stretch; }
  .application-details { grid-template-columns: repeat(2, minmax(0,1fr)); }
}

@media (max-width: 580px) {
  .auth-panel,
  .login-panel { padding: 24px 17px; }
  .login-card { padding: 23px 20px; }
  .auth-card h1,
  .login-card h1,
  .login-card h2 { font-size: 1.8rem; }
  .role-grid,
  .role-picker,
  .grid-3,
  .grid-4,
  .metric-grid { grid-template-columns: 1fr; }
  .main-content { padding: 13px; }
  .workspace-header { min-height: 76px; }
  .workspace-mark { display: none; }
  .ministry-hero { border-radius: 18px; padding: 25px 21px; }
  .ministry-hero::after { display: none; }
  .actions .button { width: 100%; }
  .auth-links,
  .import-summary { align-items: stretch; flex-direction: column; }
  .application-details { grid-template-columns: 1fr; }
  .status-card { padding: 26px 20px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
}
